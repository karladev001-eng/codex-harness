{
  "name": "@karladev001-eng/codex-harness",
  "version": "0.4.2",
  "private": true,
  "description": "Portable Codex harness and independent Markdown authoring skills",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codex-harness": "dist/skill/runtime.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "VALIDATION.md",
    "authoring-skills/README.md",
    "authoring-skills/INSTALL.md",
    "docs/adr",
    "docs/history",
    "knowledge/README.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/README.md",
    "docs/guides",
    "docs/maintainers",
    "knowledge/extension/README.md",
    "integrations/raycast-knowledge/README.md",
    "integrations/raycast-knowledge/package.json",
    "plugins/codex-harness/skills/harness/SKILL.md",
    "plugins/codex-harness/skills/harness/references",
    "plugins/codex-harness/skills/harness/assets",
    "authoring-skills"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && node scripts/test.cjs",
    "prepack": "npm run build",
    "stage:registry": "npm run build && node scripts/stage-registry.cjs",
    "check:docs": "node scripts/check-doc-links.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
