{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "codex-knowledge",
  "title": "保存資料",
  "description": "Search your local Codex knowledge snapshot",
  "icon": "extension-icon.png",
  "author": "karladev001",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-knowledge",
      "title": "保存資料を検索",
      "description": "Search saved pages, descriptions, notes and tags",
      "mode": "view",
      "keywords": [
        "knowledge",
        "kb",
        "保存",
        "検索"
      ]
    }
  ],
  "preferences": [
    {
      "name": "nodePath",
      "type": "textfield",
      "required": false,
      "title": "Node.js パス",
      "description": "Node.js 22+。空欄でHomebrewのNodeを検出"
    },
    {
      "name": "cliPath",
      "type": "textfield",
      "required": false,
      "title": "Knowledge CLI パス",
      "description": "空欄で ~/.agents/skills/codex-harness/knowledge/cli.cjs"
    },
    {
      "name": "statePath",
      "type": "textfield",
      "required": false,
      "title": "State ディレクトリ",
      "description": "空欄で ~/.codex/knowledge"
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@raycast/api": "^1.104.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
